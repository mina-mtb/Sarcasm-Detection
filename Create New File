ggingFace Dataset format\ntrain_dataset = Dataset.from_pandas(train_df[['augmented_text', 'label']])\nval_dataset = Dataset.from_pandas(val_df[['augmented_text', 'label']])\n\n# --- 3. Tokenization ---\nmodel_id = \"roberta-base\"\nprint(f\"Loading Tokenizer for {model_id}...\")\ntokenizer = RobertaTokenizerFast.from_pretrained(model_id)\n\ndef tokenize_function(examples):\n    # Max length 256 or 512 depending on T4 VRAM. 256 is usually safer for large batches.\n    return tokenizer(examples[\"augmented_text\"], truncation=True, max_length=256)\n\nprint(\"Tokenizing datasets...\")\ntrain_tokenized = train_dataset.map(tokenize_function, batched=True, remove_columns=[\"augmented_text\", \"__index_level_0__\"])\nval_tokenized = val_dataset.map(tokenize_function, batched=True, remove_columns=[\"augmented_text\", \"__index_level_0__\"])\n\ndata_collator = DataCollatorWithPadding(tokenizer=tokenizer)\n\n# --- 4. Model Initialization ---\nprint(\"Initializing RoBERTa Model...\")\nmodel = RobertaForSequenceClassification.from_pretrained(model_id, num_labels=2)\nmodel.to(device)\n\ndef compute_metrics(eval_pred):\n    logits, labels = eval_pred\n    predictions = torch.argmax(torch.tensor(logits), dim=-1)\n    acc = accuracy_score(labels, predictions)\n    f1 = f1_score(labels, predictions)\n    return {\"accuracy\": acc, \"f1\": f1}\n\n# --- 5. Training Arguments (Optimized for Kaggle T4) ---\n# CRITICAL: These settings prevent OOM and allow resuming if Kaggle stops\ntraining_args = TrainingArguments(\n    output_dir=CHECKPOINT_DIR,\n    evaluation_strategy=\"epoch\",\n    save_strategy=\"epoch\",        # Save checkpoint every epoch\n    learning_rate=2e-5,\n    per_device_train_batch_size=16, # Adjust to 8 if OOM\n    per_device_eval_batch_size=32,\n    gradient_accumulation_steps=2,  # Effective batch size = 16 * 2 = 32\n    num_train_epochs=3,\n    weight_decay=0.01,\n    fp16=True,                    # Mixed Precision for T4 speedup and memory saving\n    load_best_model_at_end=True,\n    metric_for_best_model=\"f1\",\n    report_to=\"none\"              # Disable wandb unless configured\n)\n\ntrainer = Trainer(\n    model=model,\n    args=training_args,\n    train_dataset=train_tokenized,\n    eval_dataset=val_tokenized,\n    tokenizer=tokenizer,\n    data_collator=data_collator,\n    compute_metrics=compute_metrics,\n)\n\n# --- 6. Start Training ---\nprint(\"Starting Training...\")\n# If resuming from a timeout, change resume_from_checkpoint to True or the specific folder path\ntrainer.train(resume_from_checkpoint=False)\n\n# --- 7. Save Final Model ---\nprint(\"Saving final model...\")\ntrainer.save_model(OUTPUT_PATH)\ntokenizer.save_pretrained(OUTPUT_PATH)\n\nprint(\"Phase 2C Complete! Model is trained and saved.\")\n","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}